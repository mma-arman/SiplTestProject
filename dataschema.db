--Search Student Proc----
alter Proc SearchStudent 
(
    @RegistrationNo Varchar(15),
    @StudentName Varchar(50),
    @FatherName Varchar(50),
    @MobileNo Varchar(15),
    @Gender Varchar(10),
    @RegDateFrom Date,
    @RegDateTo Date
    --SearchStudent '','','','','','',''
)
as
Begin
    Declare @Condition Nvarchar(max)=''
    Declare @Query Nvarchar(max)
    If @RegistrationNo<>''Set @Condition=@Condition+' and RegistrationNo=@RegistrationNo'
    If @StudentName<>''Set @Condition=@Condition+' AND StudentName LIKE ''%''+@StudentName+''%'''
    If @FatherName<>''Set @Condition=@Condition+'AND FatherName LIKE ''%''+@FatherName+''%
    '''
    If @MobileNo<>''Set @Condition=@Condition+ ' and MobileNo=@MobileNo'
    If @Gender<>''Set @Condition=@Condition+' and Gender=@Gender'
    If @RegDateFrom<>'' and @RegDateTo<>'' Set @Condition=@Condition+'  and CAST(CreatedDate as DATE) between @RegDateFrom and @RegDateTo'
    
    set @Query='Select RegistrationNo as [Registration No],Convert(Varchar,CreatedDate,105) AS [Registration Date],
    StudentName as [Student Name],FatherName as [Father Name],CONVERT(VARCHAR, DateOfBirth,105) as [DateOfBirth],
    MobileNo as [Mobile No],EmailId as [Email Id],Gender,City,Address from StudentMaster where 1=1'+@Condition
    print (@Query)
    Exec sp_executeSqL
    @stmt=@Query,
    @Params=N'@RegistrationNo Varchar(15),
    @StudentName Varchar(50),
    @FatherName Varchar(50),
    @MobileNo Varchar(15),
    @Gender Varchar(10),
    @RegDateFrom Date,  
    @RegDateTo Date',
    @RegistrationNo =@RegistrationNo,
    @StudentName =@StudentName,
    @FatherName =@FatherName,
    @MobileNo =@MobileNo,
    @Gender =@Gender,
    @RegDateFrom =@RegDateFrom,
    @RegDateTo =@RegDateTo
End
Go
