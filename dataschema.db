-----Student REgistration Form Table ------
Create Table StudentMaster
(
    StudentId int identity(1,1)Constraint Pk_StudentID_StudentMaster Primary Key,
    RegistrationNo Varchar(15)Constraint UK_RegistrationNo_StudentMaster Unique,
    StudentName Varchar(50),
    FatherName Varchar(50),
    DateOfBirth Date,
    MobileNo Varchar(15),
    EmailID Varchar(50),
    Password Varchar(30),
    Gender Varchar(10),
    StudentPhoto Varchar(Max),
    City Varchar(50),
    Address Varchar(200),
    CreatedDate DateTime Constraint DF_CreatedDate_StudentMaster Default Getdate(),
    ModifiedDate DateTime
)
Go
Alter Table StudentMaster
add  FileName varchar(100)
Alter Table StudentMAster
add FileType varchar(20)
Go
--- Qulafication of Student MAster Table---
Create Table QualificationStudentMaster
(
   QualificationId INT IDENTITY(1,1)Constraint Pk_QualificationStudentMaster PRIMARY KEY,
   RegistrationNo Varchar(15)Constraint Fk_QualificationStudentMaster_StudentMaster
   Foreign key References StudentMaster (RegistrationNo),
   Course Varchar(100),
   TotalMarks int,
   ObtainedMarks int,
   Year int,
   CreatedDate DateTime Constraint DF_QualificationStudentMaster Default Getdate(),
   ModifiedDate DateTime
)
Go
--Sequence Creation for Registration No
CREATE SEQUENCE Seq_RegistrationNo
START WITH 1001
INCREMENT BY 1
Go
--InsertUpdateStudentMaster--
Alter Proc USP_InsertUpdateStudentMaster
(
    @RegistrationNo Varchar(50)=null,
    @StudentName Varchar(50),
    @FatherName Varchar(50),
    @DateOfBirth Date,
    @MobileNo Varchar(15),
    @EmailID Varchar(50),
    @Password Varchar(30),
    @Gender Varchar(10),
    @StudentPhoto Varchar(Max)=null,
    @City Varchar(50),
    @Address Varchar(200),
    @FileName Varchar(100)=null,
    @FileType Varchar(20)=null,
    @CoursesXml Xml
)
As
Begin
    Declare @Msg Varchar(max);
    Declare @Status Varchar(max)='0';   
    If @RegistrationNo is not null AND EXISTS(SELECT 1 FROM StudentMaster WHERE RegistrationNo=@RegistrationNo)
    Begin
    Begin Try
    Begin Transaction
        Update StudentMaster
        Set StudentName=@StudentName,FatherName=@FatherName,DateOfBirth=@DateOfBirth,MobileNo=@MobileNo,EmailID=@EmailID,Password=@Password,Gender=@Gender,
        StudentPhoto = IIF(@StudentPhoto IS NULL OR @StudentPhoto = '', StudentPhoto, @StudentPhoto),
        City=@City,Address=@Address,
        FileName = IIF(@FileName IS NULL OR @FileName='', FileName, @FileName),
        FileType = IIF(@FileType IS NULL OR @FileType='', FileType, @FileType)      
        where RegistrationNo=@RegistrationNo

        Delete From QualificationStudentMaster where RegistrationNo=@RegistrationNo

        Insert Into QualificationStudentMaster(RegistrationNo,Course,TotalMarks,ObtainedMarks,Year)
        Select @RegistrationNo,
        Course.value('(CourseName)[1]', 'VARCHAR(50)'),
        Course.value('(TotalMarks)[1]', 'INT'),
        Course.value('(ObtainedMarks)[1]', 'INT'),
        Course.value('(Year)[1]', 'INT')    
        From @CoursesXml.nodes('/Courses/Course') AS T(Course)  
        set @Msg='Update Succesfully';
        Set @Status='1';
    Commit Transaction
    End Try
    Begin Catch
        Rollback Transaction
        Set @Msg=ERROR_MESSAGE();
        Set @Status='0';
        End Catch
    End
    Else
        Begin
        Begin Try
           Begin Transaction
           Set @RegistrationNo='RG'+CAST(NEXT VALUE FOR Seq_RegistrationNo AS VARCHAR(10))
            If Exists(Select 1 from StudentMaster where EmailID=@EmailID )
            Begin
                Set @Msg='Student Already Registered';
                  Rollback Transaction;
            End
            Else 
            Begin
                Insert Into StudentMaster
                (
                    RegistrationNo,StudentName,FatherName,DateOfBirth,MobileNo,EmailID,
                    Password,Gender,StudentPhoto,City,Address,FileName,FileType
                )
                Values
                (
                    @RegistrationNo,@StudentName,@FatherName,Cast(@DateOfBirth AS date),@MobileNo,@EmailID,@Password,@Gender,
                    @StudentPhoto,@City,@Address,@FileName,@FileType     
                )
                Insert Into QualificationStudentMaster(RegistrationNo,Course,TotalMarks,ObtainedMarks,Year)
                Select @RegistrationNo,
                Course.value('(CourseName)[1]', 'VARCHAR(50)'),
                Course.value('(TotalMarks)[1]', 'INT'),
                Course.value('(ObtainedMarks)[1]', 'INT'),
                Course.value('(Year)[1]', 'INT')    
                From @CoursesXml.nodes('/Courses/Course') AS T(Course)                   
                Set @Msg='Registration Succesfully';
                Set @Status='1';
                Commit Transaction
            End          
        End Try
        Begin Catch
            RollBack Transaction
            Set @Msg=ERROR_MESSAGE();
            Set @Status='0';
        End Catch
    End  
    Select @Msg As Msg,@Status As Status
End
Go
