--Admission Master
Create Table AdmissionMaster
(
    AdmissionId int identity(1,1)Constraint Pk_AdmissionMAster_AdmissionId Primary Key,
    AdmissionNo Varchar(20)Constraint Uk_AdmissionMaster_AdmissionNo Unique,
    RegistrationNo Varchar(15)Constraint Fk_AdmissionMaster_StudentMAster_RegistrationNo Foreign key References StudentMaster(RegistrationNo),
    StudentName Varchar(50),
    ParentsName Varchar(50),
    ParentsProfession Varchar(100),
    StudentDob Date,
    MobileNo Varchar(15),
    EmailID Varchar(50),
    Gender Varchar(10),
    StudentPhoto Varchar(Max),
    City Varchar(50),
    Address Varchar(200),
    CreatedDate DateTime Constraint DF_AdmissionMaster_CreatedDate Default Getdate(),
    ModifiedDate DateTime,
    FileName varchar(100),
    FileType varchar(20)
)
Go
--Table Of Academic Qualifiation
Create Table AcademicQualification
(
   QualificationId INT IDENTITY(1,1)Constraint Pk_AcademicQualification Primary Key,
   AdmissionNo Varchar(20)Constraint Fk_AcadmeicQualification_ADmissionMAster Foreign Key references AdmissionMaster(AdmissionNo),
   Institute Varchar(100),
   Course Varchar(100),
   PassingYear int,
   TotalMarks int,
   ObtainedMarks int,
   Percentage Decimal(5,2),
   CreatedDate DateTime Constraint DF_AcademicQualification Default Getdate(),
   ModifiedDate DateTime
)
Go
--Procedure For insert Update Academic Qualification
CREATE SEQUENCE Seq_AdmissionNo
START WITH 1001
INCREMENT BY 1
alter Proc USP_InsertUpdateAdmissionMaster
(
    @AdmissionNo Varchar(20),
    @RegistrationNo Varchar(15),
    @StudentName Varchar(50),
    @ParentsName Varchar(50),
    @ParentsProfession Varchar(100),
    @StudentDob Date,
    @MobileNo Varchar(15),
    @EmailID Varchar(50),
    @Gender Varchar(10),
    @StudentPhoto Varchar(Max)=null,
    @City Varchar(50),
    @Address Varchar(200),
    @FileName Varchar(100)=null,
    @FileType Varchar(20)=null,
    @CoursesXml Xml
)
As
Begin
    Declare @Msg Varchar(max);
    Declare @Status Varchar(max)='0';   
    If @AdmissionNo is not null and exists(select 1 from AdmissionMaster where AdmissionNo=@AdmissionNo )
    Begin
    Begin Try
    Begin Transaction
         Update AdmissionMaster
        Set StudentName=@StudentName,ParentsName=@ParentsName,ParentsProfession=@ParentsProfession,
        StudentDob=@StudentDob,MobileNo=@MobileNo,EmailID=@EmailID,Gender=@Gender,
        StudentPhoto = IIF(@StudentPhoto IS NULL OR @StudentPhoto = '', StudentPhoto, @StudentPhoto),
        City=@City,Address=@Address,
        FileName = IIF(@FileName IS NULL OR @FileName='', FileName, @FileName),
        FileType = IIF(@FileType IS NULL OR @FileType='', FileType, @FileType)      
        where AdmissionNo=@AdmissionNo
        Delete From AcademicQualification where AdmissionNo=@AdmissionNo

        Insert Into AcademicQualification(AdmissionNo,Institute,Course,PassingYear,TotalMarks,ObtainedMarks,Percentage)
       Select @AdmissionNo,
                Course.value('(InstituteName)[1]', 'VARCHAR(100)'),
                Course.value('(CourseName)[1]', 'VARCHAR(100)'),
                Course.value('(Year)[1]', 'INT'),
                Course.value('(TotalMarks)[1]', 'INT') ,
                Course.value('(ObtainedMarks)[1]', 'INT'),
                Course.value('(Percentage)[1]', 'Decimal(5,2)')
                From @CoursesXml.nodes('/AcademicQualification/Course') AS T(Course)                   
                Set @Msg='Admission Updated Successfully';
                Set @Status='1';
    Commit Transaction
    End Try
    Begin Catch
        Rollback Transaction
        Set @Msg=ERROR_MESSAGE();
        Set @Status='0';
        End Catch
    End
    Else
        Begin
        Begin Try
          Begin Transaction
            If Exists(Select 1 from AdmissionMaster where RegistrationNo=@RegistrationNo)
            Begin
                Set @Msg='Admission already registered for this student.';
            End
            Else If Exists(Select 1 from AdmissionMaster where EmailID=@EmailID)
            Begin
                Set @Msg = 'Student with this email is already registered.';
                Set @Status = '0';
            End
            Else If not exists(select 1 from StudentMaster where RegistrationNo=@RegistrationNo )
            Begin
                set @Msg='You are not registered for admission. Please register first.';           
            End
            Else
            Begin
                Set @AdmissionNo='AD'+CAST(NEXT VALUE FOR Seq_AdmissionNo AS VARCHAR(10))
                Insert Into AdmissionMaster
                (
                    AdmissionNo,RegistrationNo,StudentName,ParentsName,ParentsProfession,StudentDob,MobileNo,EmailID,
                    Gender,StudentPhoto,City,Address,FileName,FileType
                )
                Values
                (
                    @AdmissionNo,@RegistrationNo,@StudentName,@ParentsName,@ParentsProfession,@StudentDob,@MobileNo,@EmailID,@Gender,@StudentPhoto,@City,@Address,@FileName,@FileType
                )
                Insert Into AcademicQualification(AdmissionNo,Institute,Course,PassingYear,TotalMarks,ObtainedMarks,Percentage)
                Select @AdmissionNo,
                Course.value('(InstituteName)[1]', 'VARCHAR(100)'),
                Course.value('(CourseName)[1]', 'VARCHAR(100)'),
                Course.value('(Year)[1]', 'INT'),
                Course.value('(TotalMarks)[1]', 'INT') ,
                Course.value('(ObtainedMarks)[1]', 'INT'),
                Course.value('(Percentage)[1]', 'Decimal(5,2)')
                From @CoursesXml.nodes('/AcademicQualification/Course') AS T(Course)                   
                Set @Msg='Admission Registered Successfully';
                Set @Status='1';
           End           
          Commit Transaction
        End Try
        Begin Catch
            RollBack Transaction
            Set @Msg=ERROR_MESSAGE();
            Set @Status='0';
        End Catch
    End  
    Select @Msg As Msg,@Status As Status
End
Go
