Alter Proc USP_StudentReport 
as
Begin
select '' As RegistrationNo,'' As StudentName,'' As FatherName,'' As DateOfBirth ,'' As MobileNo,'' As EmailId,'' As Gender,'' As StudentPhoto,'' As CreatedDAte,
'' As City,'' As Address,'' As Course,''As TotalMarks,'' As ObtainedMarks, '' As Year
End
*/

Alter Proc USP_StudentReport 
(
    @RegistrationNo varchar(15)
)
as
Begin
select SM.RegistrationNo,SM.StudentName,Sm.FatherName,Convert(Varchar,Sm.DateOfBirth,105)As DateOfBirth,Sm.MobileNo,SM.EmailID,SM.Gender,SM.StudentPhoto, Convert(Varchar,SM.CreatedDate,105) As CreatedDate,
SM.City,SM.Address,QM.Course,Qm.TotalMarks,QM.ObtainedMarks,QM.Year from StudentMaster SM Left Join QualificationStudentMaster QM on 
SM.RegistrationNo=Qm.RegistrationNo where sm.RegistrationNo=@RegistrationNo
End
Go

--Proc For Search Admission/master Student--

alter Proc USP_SearchStudentAdmission 
(
    @AdmissionNo Varchar(15),
    @RegistrationNo Varchar(15),
    @StudentName Varchar(50),
    @ParentsName Varchar(50),
    @MobileNo Varchar(15),
    @Gender Varchar(10),
    @AdmDateFrom Date,
    @AdmDateTo Date
    --USP_SearchStudentAdmission '566','ads','','','','','',''
)
as
Begin
    Declare @Condition Nvarchar(max)=''
    Declare @Query Nvarchar(max)
    If @AdmissionNo<>''Set @Condition=@Condition+' and AdmissionNo=@AdmissionNo'
    If @RegistrationNo<>''Set @Condition=@Condition+' and RegistrationNo=@RegistrationNo'
    If @StudentName<>''Set @Condition=@Condition+' AND StudentName LIKE ''%''+@StudentName+''%'''
    If @ParentsName<>''Set @Condition=@Condition+' AND ParentsName LIKE ''%''+@ParentsName+''%'''
    If @MobileNo<>''Set @Condition=@Condition+ ' and MobileNo=@MobileNo'
    If @Gender<>''Set @Condition=@Condition+' and Gender=@Gender'
    If @AdmDateFrom is not null and @AdmDateTo is not null Set @Condition=@Condition+' and CAST(CreatedDate as DATE) between @AdmDateFrom and @AdmDateTo'
    
    set @Query='Select AdmissionNo as [Admission No],Convert(Varchar,CreatedDate,105) AS [Admission Date],RegistrationNo As [Registration No] ,
    StudentName as [Student Name],ParentsName as [Parents Name],CONVERT(VARCHAR, StudentDob,105) as [Student Dob],
    MobileNo as [Mobile No],EmailId as [Email Id],Gender,City,Address from AdmissionMaster where 1=1'+@Condition
    
      print(@Condition)
      print (@Query)
  
    Exec sp_executeSqL
    @stmt=@Query,
    @Params=N'@AdmissionNo Varchar(15),
    @RegistrationNo Varchar(15),
    @StudentName Varchar(50),
    @ParentsName Varchar(50),
    @MobileNo Varchar(15),
    @Gender Varchar(10),
    @AdmDateFrom Date,  
    @AdmDateTo Date',
    @AdmissionNo =@AdmissionNo,
    @RegistrationNo=@RegistrationNo,
    @StudentName =@StudentName,
    @ParentsName =@ParentsName,
    @MobileNo =@MobileNo,
    @Gender =@Gender,
    @AdmDateFrom =@AdmDateFrom,
    @AdmDateTo =@AdmDateTo
End
/*
alter Proc USP_AdmissionReport
as
Begin
select ''As AdmissionNo  ,'' As RegistrationNo,'' As StudentName,'' As ParentsName,'' As StudentDob ,'' As MobileNo,'' As EmailId,'' As Gender,'' As StudentPhoto,'' As CreatedDAte,
'' As City,'' As Address,'' AS Institute,'' As Course,''As TotalMarks,'' As ObtainedMarks, '' As PassingYear
End
*/ 


alter Proc USP_AdmissionReport
(
    @AdmissionNo Varchar(15)
)
as
Begin
    Select AM.AdmissionNo,Am.RegistrationNo,Convert(varchar,Am.CreatedDate,105)As CreatedDate, AM.StudentName,AM.ParentsName,
    Convert(varchar,AM.StudentDob,105)as StudentDob,AM.MobileNo, AM.EmailID,AM.Gender,Am.StudentPhoto, AM.City,
    AM.Address,AQ.Institute,AQ.Course,AQ.TotalMarks,AQ.ObtainedMarks,AQ.PassingYear 
    from AdmissionMaster AM Left Join AcademicQualification AQ  On AM.AdmissionNo=AQ.AdmissionNo 
    Where AM.AdmissionNo=@AdmissionNo
End
Go
--join for show data from pincode
select Cm.CountryCode+' : ' +cm.CountryName as Country, SM.stateCode+' : ' +SM.StateName As State, CityMAster.City,PinCode  from CountryMaster Cm left join StateMaster SM on CM.CountryCode=SM.CountryCode 
Left join CityMaster  on CityMaster.CountryCode=Cm.CountryCode and CityMaster.StateCode =SM.StateCode 
LEFT JOIN PinCodeMaster PM ON PM.CountryCode = CM.CountryCode  AND PM.StateCode = SM.StateCode  AND PM.City = CityMaster.City 


Alter proc USP_Login
(
    @UserCode varchar(50),
    @Password Varchar(50)
)
As
Begin
    Declare @Status varchar(max)='0';
    Declare @Msg Varchar(max)
    Declare @UserName Varchar(max)
    if Exists (select 1 from UserMaster where UserCode=@UserCode and Password=@Password)
    Begin
        Set @UserName=(select UserName from UserMaster where UserCode=@UserCode)
        Set @Status='1';
        Set @Msg='Login Succesfully';
    End
    Else
    Begin
        Set @Status='0';
        Set @Msg='Invalid Credentilas';
    End
    select @Msg AS Msg ,@Status As Status,@UserName as UserName
End
