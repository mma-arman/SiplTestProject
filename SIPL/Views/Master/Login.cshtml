
@{
    Layout = null;
}
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="~/Script/Login.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    /* Background image styling */
    .bg-custom {
        /* Yahan apni image ka link ya path dalein */
        background-image: url('https://commercial.bridgestone.com/content/dam/dcoe/commercial/global/bu-homepage/getty-images-tbr-home.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        /* 100% Height and Width */
        height: 100vh;
        width: 100vw;
        margin: 0;
        overflow: hidden;
    }
</style>

<body class="bg-custom d-flex align-items-center justify-content-lg-end" style="padding-right:70px;">

    <div class="card shadow-lg " style="width: 400px; border-radius: 15px;">

        <div class="card-body ">
            <h3 class="text-center mb-4 fw-bold text-primary">Login</h3>

            <form>
                <div class="mb-3">
                    <label class="form-label fw-semibold">User Code </label>
                    <input id="UserCode" type="text" class="form-control" placeholder="Enter your User Code" required>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Password</label>
                    <input id="Password" type="password" class="form-control" placeholder="Enter Password" required>
                </div>

                <div class="d-grid">
                    <button id="Submit" type="button" class="btn btn-primary btn-lg">Log In</button>
                </div>

                <div class="text-center mt-3">
                    <a href="#" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
                        Forgot password?
                    </a>
                </div>
            </form>
        </div>

    </div>

</body>
