
@{
    ViewBag.Title = "StudentMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
    <script src="~/Script/StudentMaster.js"></script>
</head>

<body>

    <div class="container mt-5" style="max-width:900px;">

        <div class="card shadow">

            <div class="card-header text-center" style="background-color:#FFE4E1;">
                <h4>Student Registration Form</h4>
            </div>

            <div class="card-body" style="background-color:#FFE4E1;">

                <form id="Form" class="EnterPressNext">

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Registration No </label>
                        <div class="col-md-6">
                            <input id="RegistrationNo" onblur="EditStudentMaster()" onkeyup="AutoComplete('RegistrationNo','RegistrationNo')" disabled type="text" class="form-control form-control-sm" placeholder="System Generated">
                        </div>
                        <div class="col-md-1">
                            <input class="mt-3 ms-5" onchange="UpdateCheckBox();" type="checkbox" id="Update" />
                        </div>
                        <label class="col-md-2 pb-2 col-form-label">Update</label>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Student Name<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="StudentName" name="StudentName" oninput="this.value=this.value.replace(/[^a-zA-Z ]/g,'')" type="text" class="form-control form-control-sm" placeholder="Student Name">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Father Name<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="FatherName" oninput="this.value=this.value.replace(/[^a-zA-Z ]/g,'')" name="FatherName" type="text" class="form-control form-control-sm" placeholder="Father Name">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Date Of Birth<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input oninput="DateOfBirthValidation()" id="DateOfBirth" name="DateOfBirth" type="date"  class="form-control form-control-sm">
                        </div>                       
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Mobile No<span class="text-danger">*</span> </label>

                        <div class="col-md-9">
                            <input id="MobileNo" name="MobileNo" type="text" class="form-control form-control-sm" maxlength="10" placeholder="Mobile Number" oninput="this.value=this.value.replace(/[^0-9]/g,'')">

                        </div>                          

                        </div>

                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label">Email<span class="text-danger">*</span> </label>
                            <div class="col-md-9">
                                <input id="EmailId" name="EmailId" placeholder="Email" type="email" class="form-control form-control-sm">
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label">Password<span class="text-danger">*</span> </label>
                            <div class="col-md-9">
                                <div class="input-group mb-3">
                                    <input  id="Password" name="Password" placeholder="Password" type="password" class="form-control form-control-sm">
                                    <button  class="btn bg-light" type="button" id="togglePassword">
                                        <i class="fa fa-eye-slash"></i>
                                    </button>
                                </div>
                                
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label">Gender<span class="text-danger">*</span> </label>

                            <div class="col-md-9">

                                <div class="form-check form-check-inline">
                                    <input id="Male" class="form-check-input" type="radio" value="Male" name="Gender">
                                    <label class="form-check-label">Male</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input id="Female" class="form-check-input" type="radio" value="Female" name="Gender">
                                    <label class="form-check-label">Female</label>
                                </div>

                            </div>
                        </div>

                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label">Student Photo<span class="text-danger">*</span> </label>
                            <div class="col-md-9">
                                <input id="StudentPhoto" name="StudentPhoto" type="file" class="form-control form-control-sm">
                                <span id="FileName"></span>
                            </div>
                        </div>
                        <label class="row mb-2">
                            <div class="col-md-3">

                            </div>
                            <img id="StudentPhotoPreview" style="display:none; height:150px; width:250px;">
                        </label>

                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label">City<span class="text-danger">*</span> </label>
                            <div class="col-md-9">
                                <input placeholder="City"  onkeyup="AutoComplete('City','GetCity')" id="City" name="City" type="text" class="form-control form-control-sm">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-md-3 col-form-label">Address<span class="text-danger">*</span> </label>
                            <div class="col-md-9">
                                <textarea placeholder="Address" id="Address" name="Address" class="form-control form-control-sm" rows="2"></textarea>
                            </div>
                        </div>



                        <div class="row">
             

                            <div class="col-md-4">
                                <input hidden type="number" id="TempId" />
                                <label class="form-label">Course<span class="text-danger">*</span></label>
                                <input type="text" id="Course" name="Course" class="form-control form-control-sm" placeholder="Course">
                            </div>
                          

                            <div class="col-md-2">
                                <label class="form-label">Total Marks<span class="text-danger">*</span></label>
                                <input type="text" id="TotalMarks" name="TotalMarks" oninput="this.value=this.value.replace(/\D/g,'')" class="form-control form-control-sm" placeholder="Total Marks">
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Obtained Marks<span class="text-danger">*</span></label>
                                <input type="text" id="ObtainedMarks" name="ObtainedMarks" oninput="this.value=this.value.replace(/\D/g,'')" class="form-control form-control-sm" placeholder="Obtained Marks">
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Year<span class="text-danger">*</span></label><br />
                                <select class="form-control form-control-sm"  id="Year"></select>
                            </div>
                            <div class="col-md-2">
                                <br />
                                <button class="mt-2" type="button" id="CourseSave">Save</button>
                                <button class="mt-2" type="button" id="CourseReset">Reset</button>
                            </div>

                        </div>
                        <div>
                            <div id="CourseDisplay"></div>
                        </div>


                        <div class="text-center mt-5 mb-3">
                            <button id="Register" type="button" class="btn btn-primary execute btn-sm">Register</button>
                            <button id="Reset" type="reset" class="btn btn-secondary btn-sm">Reset</button>
                        </div>

</form>

            </div>
        </div>

    </div>




</body>
</html>