@{
    ViewBag.Title = "AdmissionMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Script/AdmissionMaster.js"></script>

<!DOCTYPE html>
<html>
<head>
    <title>Admission Form</title>

</head>
<body>

    <div class="container mt-5" style="max-width:900px;">

        <div class="card shadow">

            <div class="card-header text-center" style="background-color:#FFE4E1;">
                <h4>Student Admission Form</h4>
            </div>

            <div class="card-body" style="background-color:#FFE4E1;">

                <form id="Form" class="EnterPressNext">

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Admission No </label>
                        <div class="col-md-6">
                            <input id="AdmissionNo" onkeyup="AutoComplete('AdmissionNo','AdmissionNo')" onblur="ShowStudentDetailFromAdmission()" disabled type="text" class="form-control form-control-sm" placeholder="System Generated">
                        </div>
                        <div class="col-md-1">
                            <input class="mt-3 ms-5" onchange="UpdateCheckBox();" type="checkbox" id="Update" />
                        </div>
                        <label class="col-md-2 pb-2 col-form-label">Update</label>
                    </div>
                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Registration No<span class="text-danger">*</span> </label>
                        <div class="col-md-9">

                            <input id="RegistrationNo" onkeyup="AutoComplete('RegistrationNo','RegistrationNo')" onblur="ShowStudentDetailFromRegistrationNo()" type="text" class="form-control form-control-sm" placeholder="Registration No">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Student Name<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="StudentName" name="StudentName" oninput="this.value=this.value.replace(/[^a-zA-Z ]/g,'')" type="text" class="form-control form-control-sm" placeholder="Student Name">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Parents Name<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="ParentsName" oninput="this.value=this.value.replace(/[^a-zA-Z ]/g,'')" name="FatherName" type="text" class="form-control form-control-sm" placeholder="Parents Name">
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Parents Profession </label>
                        <div class="col-md-9">
                            <input id="ParentsProfession" oninput="this.value=this.value.replace(/[^a-zA-Z ]/g,'')" type="text" class="form-control form-control-sm" placeholder="Parents Profession">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">StudentDob<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="StudentDob" name="DateOfBirth" type="date" class="form-control form-control-sm">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Mobile No<span class="text-danger">*</span> </label>

                        <div class="col-md-9">
                            <input id="MobileNo" name="MobileNo" type="text" class="form-control form-control-sm" maxlength="10" placeholder="Mobile No" oninput="this.value=this.value.replace(/[^0-9]/g,'')">

                        </div>

                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Email<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="EmailId" name="EmailId" type="email" class="form-control form-control-sm" placeholder="Email">
                        </div>
                    </div>


                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Gender<span class="text-danger">*</span> </label>

                        <div class="col-md-9">

                            <div class="form-check form-check-inline">
                                <input id="Male" class="form-check-input" type="radio" value="Male" name="Gender">
                                <label class="form-check-label">Male</label>
                            </div>

                            <div class="form-check form-check-inline">
                                <input id="Female" class="form-check-input" type="radio" value="Female" name="Gender">
                                <label class="form-check-label">Female</label>
                            </div>

                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">Student Photo<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input id="StudentPhoto" accept=".jpg, .jpeg, .png, .webp" name="StudentPhoto" type="file" class="form-control form-control-sm">
                            <span id="FileName"></span>
                        </div>
                    </div>
                    <div class="row mb-2">    
                        <div class="col-md-3"></div>
                        <img id="StudentPhotoPreview" style="display:none; height:150px; width:250px;">
                    </div>

                    <div class="row mb-2">
                        <label class="col-md-3 col-form-label">City<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <input onkeyup="AutoComplete('City','GetCity')" id="City" name="City" type="text" class="form-control form-control-sm" placeholder="City">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-md-3 col-form-label">Address<span class="text-danger">*</span> </label>
                        <div class="col-md-9">
                            <textarea placeholder="Address" id="Address" name="Address" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                    </div>



                    <div class="row">

                        <div class="col-md-12">
                            <h5 class="mb-3">Academic Qualification</h5>
                        </div>

                        <input hidden type="number" id="TempId" />

                        <!-- Row 1 -->
                        <div class="col-md-4">
                            <label class="form-label">Institute Name<span class="text-danger">*</span></label>
                            <input type="text" id="InstituteName" name="Institute" class="form-control form-control-sm" placeholder="Institute Name">
                        </div>

                        <div class="col-md-4">

                            <label class="form-label">Course Name<span class="text-danger">*</span></label>
                            <input type="text" id="Course" name="Course" class="form-control form-control-sm" placeholder="Course Name">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Passing Year<span class="text-danger">*</span></label>
                            <select id="Year" class="form-control form-control-sm"></select>
                        </div>

                        <!-- Row 2 -->
                        <div class="col-md-3 mt-2">
                            <label class="form-label">Total Marks<span class="text-danger">*</span></label>
                            <input type="text" onkeyup="percentage()" id="TotalMarks"maxlength="10" oninput="this.value=this.value.replace(/\D/g,'')" class="form-control form-control-sm" placeholder="Total Marks">
                        </div>

                        <div class="col-md-3 mt-2">
                            <label class="form-label">Obtained Marks<span class="text-danger">*</span></label>
                            <input type="text" onkeyup="percentage()"  maxlength="10" id="ObtainedMarks" oninput="this.value=this.value.replace(/\D/g,'')" class="form-control form-control-sm" placeholder="Obtained Marks">
                        </div>

                        <div class="col-md-3 mt-2">
                            <label class="form-label">Percentage</label>
                            <input type="text" id="Percentage" class="form-control form-control-sm" placeholder="Percentage" readonly>
                        </div>

                        <div class="col-md-3 pt-3">
                            <label class="form-label mb-3"></label><br />
                            <button class="btn btn-primary btn-sm" type="button" id="CourseSave">Save</button>
                            <button class="btn btn-secondary btn-sm" type="button" id="CourseReset">Reset</button>
                        </div>

                    </div>
                    <div>
                        <div id="CourseDisplay"></div>
                    </div>


                    <div class="text-center mt-5 mb-3">
                        <button id="Register" type="button" class="btn btn-primary execute btn-sm">Register</button>
                        <button id="Reset" type="reset" class="btn btn-secondary btn-sm">Reset</button>
                    </div>

                </form>

            </div>
        </div>

    </div>




</body>
</html>
